# SQLite file. In Docker this defaults to /data/movie-vote.db
DATABASE_URL=./data/movie-vote.db

# Public URL friends use (Cloudflare Tunnel hostname). Needed in production.
ORIGIN=https://movies.example.com

# Internal URLs on the Docker network + API keys (Settings → General in each app)
SEERR_URL=http://seerr:5055
SEERR_API_KEY=
RADARR_URL=http://radarr:7878
RADARR_API_KEY=

# Discord channel webhook (Channel settings → Integrations → Webhooks)
DISCORD_WEBHOOK_URL=

# Your Seerr user ID (Seerr → Users). Blank = first user to sign in becomes owner.
OWNER_SEERR_USER_ID=

TZ=Australia/Adelaide
