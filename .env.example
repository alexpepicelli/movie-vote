# SQLite file. In Docker this defaults to /data/votarr.db
DATABASE_URL=./data/votarr.db

# Optional: pin the public URL. Normally worked out from the request (Cloudflare Tunnel
# passes the hostname through), so leave unset unless you need to.
# ORIGIN=https://votarr.example.com

# Optional: Seerr/Radarr connection. Easier to set in Admin → Settings, which overrides these.
SEERR_URL=http://seerr:5055
SEERR_API_KEY=
RADARR_URL=http://radarr:7878
RADARR_API_KEY=

# Discord channel webhook (Channel settings → Integrations → Webhooks)
DISCORD_WEBHOOK_URL=

# Your Seerr user ID (Seerr → Users). Blank = first user to sign in becomes owner.
OWNER_SEERR_USER_ID=

TZ=Australia/Adelaide
